# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GitHub Excel URLs para carregamento automático dos 3 arquivos
# 1. AT1 - DASH AT1 PERSONA_ATUALIZADO.xlsx
VITE_GITHUB_EXCEL_URL="https://raw.githubusercontent.com/carloswladier/DASH_AT1_G1/main/DASH%20AT1%20PERSONA_ATUALIZADO.xlsx"

# 2. OUTAGE - OUTAGE_SGO.xlsx
VITE_GITHUB_OUTAGE_URL="https://raw.githubusercontent.com/carloswladier/DASH_AT1_G1/main/OUTAGE_SGO.xlsx"

# 3. REVISITA 30D - REVISITA_30D_Norte.xlsx
VITE_GITHUB_REVISITA_URL="https://raw.githubusercontent.com/carloswladier/DASH_AT1_G1/main/REVISITA_30D_Norte.xlsx"

# Hostinger MySQL Database Configuration
DB_HOST="localhost"
DB_USER="u123456789_admin"
DB_PASSWORD="sua_senha_mysql"
DB_NAME="u123456789_indicadores"
DB_PORT="3306"

# Or standard connection string:
DATABASE_URL=""
